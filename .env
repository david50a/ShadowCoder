# ShadowCoder Environment Variables
# Copy to .env and fill in values

# ── Security ──────────────────────────────────────────────────────────────────
SHADOWCODER_SECRET_KEY=change-this-to-a-random-64-char-string

# ── AI (Phase 5: Local Ollama) ────────────────────────────────────────────────
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# ── Stripe Billing ────────────────────────────────────────────────────────────
...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
STRIPE_TEAM_YEARLY_PRICE_ID=price_...

# ── CI/CD Webhooks ────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITLAB_WEBHOOK_SECRET=your-gitlab-token

# ── Database (Production) ─────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/shadowcoder
# REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4
